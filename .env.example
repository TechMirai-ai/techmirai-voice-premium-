# Copy this file to .env and fill in real values. NEVER commit .env.
# Every variable below is read and validated in src/env.ts.

# --- Required ---------------------------------------------------------------

# Node environment: development | test | production
NODE_ENV=development

# Port the Express server listens on.
PORT=3000

# Postgres connection string for the development database.
# Must match the credentials and port of the "postgres-dev" service in docker-compose.yml.
DATABASE_URL=postgres://voice:voice@localhost:5433/techmirai_voice_premium

# Public HTTPS base URL of this server, as Vapi will call it.
# In local development this is a tunnel URL (ngrok / cloudflared), e.g. https://xxxx.ngrok-free.app
# It does not need to be reachable for `npm test`/`npm run vapi:sync` (dry-run) to pass —
# only for a real manual test call, where the callback webhook will hit it.
# Never hard-code server URLs anywhere else — see docs/FUTURE-FEATURES.md F-4 and F-8.
PUBLIC_BASE_URL=

# Vapi private API key (server side only — never expose to a browser).
# Get it from the Vapi dashboard: Settings -> API Keys ("Private Key").
# Required from VP-2 onwards, but only needs to be a real, working key for
# `npm run vapi:sync -- ... --apply` and the manual test page — dry-run and
# `npm test` never call the network, so a placeholder string is enough there.
VAPI_API_KEY=

# Vapi public key (safe for the browser test page / Web SDK).
# Get it from the Vapi dashboard: Settings -> API Keys ("Public Key").
VAPI_PUBLIC_KEY=

# Shared secret for the voice webhooks (/api/voice/*). Every request without it is
# rejected with 401 — in development too. Generate one:  openssl rand -hex 32
# It MUST equal the token of the Custom Credential you create by hand in the Vapi
# dashboard (Vapi does not allow creating credentials through its API) — see README
# "Vapi webhook authentication".
VAPI_WEBHOOK_SECRET=

# Id of that Custom Credential (dashboard -> Integrations -> the credential's id).
# `npm run vapi:sync` puts it on every tool as `server.credentialId`.
VAPI_SERVER_CREDENTIAL_ID=

# Signs the staff dashboard's session cookie (express-session). Must be at
# least 32 characters. Generate one:  openssl rand -hex 32
SESSION_SECRET=

# --- Optional --------------------------------------------------------------

# Postgres connection string for the test database.
# Must match the "postgres-test" service in docker-compose.yml. Used by `npm test`.
TEST_DATABASE_URL=postgres://voice:voice@localhost:5434/techmirai_voice_premium_test

# How many reverse proxies sit in front of this server (1 behind ngrok / a load
# balancer). Lets rate limiting see the real caller IP. Leave blank if exposed directly.
TRUST_PROXY_HOPS=

# Only needed by `npm run vapi:test-chat` (the local text-based prompt tester,
# VP-7) — never by production or `npm test`. Calls OpenAI directly with the
# same model production uses (gpt-4o-mini), not a substitute — see
# VAPI-FACTS.md VP-7 R4. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Docker Compose only ----------------------------------------------------
# Credentials for the local Postgres containers defined in docker-compose.yml.
POSTGRES_USER=voice
POSTGRES_PASSWORD=voice
POSTGRES_DB=techmirai_voice_premium
POSTGRES_TEST_DB=techmirai_voice_premium_test
POSTGRES_DEV_PORT=5433
POSTGRES_TEST_PORT=5434
